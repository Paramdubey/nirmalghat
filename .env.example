# Copy to .env (git-ignored) and fill in from your Supabase project: Project Settings > API.
# Only the public anon key goes here. NEVER put the service_role key in this app or in git.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Also accepted (for Vercel's Supabase integration): NEXT_PUBLIC_SUPABASE_URL and
# NEXT_PUBLIC_SUPABASE_ANON_KEY or NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
